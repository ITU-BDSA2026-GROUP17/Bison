<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>exe</OutputType>
    <TargetFramework>net8</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PublishSingleFile>true</PublishSingleFile> <!-- Compiles all files into one executable -->
    <SelfContained>false</SelfContained> <!-- But require the .NET runtime (assumed everyone has it) -->
    <PublishReadyToRun>false</PublishReadyToRun> <!-- Maybe update to true later if needed -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.31" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SQLite" Version="8.0.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bison.Database\Bison.Database.csproj" />
  </ItemGroup>

</Project>
