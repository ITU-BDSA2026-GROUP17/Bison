@using Bison.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<User> signInManager
@inject UserManager<User> userManager
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="navigation">
    @if (User.Identity is not null && signInManager.IsSignedIn(User))
    {
        <div>
            <a href="/@(User.Identity.Name)">
                My Observations
            </a>
            |
            <a href="/">
                Public Observations
            </a>
            |
            <form class="form-inline" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/")" asp-area="Identity"
                  method="post">
                <button type="submit">
                    Logout
                </button>
            </form>
        </div>
    }
    else
    {
        <div>
            <a href="/">
                Public Observations
            </a>
            |
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">
                Register
            </a>
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">
                Login
            </a>
        </div>
    }
</div>