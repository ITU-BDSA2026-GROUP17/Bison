@page "/ob/{id}"
@model Bison.Razor.Pages.ObservationModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>


    @if (Model.Observation is not null)
    {
        <h2> Public Timeline </h2>
        <ul id="messagelist" class="observations">
            <li>
                <p>
                    <strong>
                        <a href="/@Model.Observation.Author.Username">@Model.Observation.Author.Name</a>
                    </strong>
                    @Model.Observation.Description
                    <small>&mdash; @Model.Observation.CreatedAt</small>
                </p>
            </li>
        </ul>
        <ul id="messagelist" class="observations">
            @foreach (var comment in Model.Comments)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/@comment.Author.Username">@comment.Author.Name</a>
                        </strong>
                        @comment.Comment
                        <small>&mdash; @comment.CreatedAt</small>
                    </p>
                </li>
            }
        </ul>
        <ul id="messagelist" class="observations">
            @foreach (var proposal in Model.Proposals)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/@proposal.Author.Username">@proposal.Author.Name</a>
                        </strong>
                        @proposal.TaxonName
                        <small>&mdash; @proposal.CreatedAt</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <h2>404 - Observation id does not exist</h2>
    }
</div>
