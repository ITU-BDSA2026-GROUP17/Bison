@page "/obs/{author}"
@model Bison.Razor.Pages.UserTimelineModel
@{
    ViewData["Title"] = "Bison";
    var routeName = HttpContext.GetRouteValue("author");
}

<div>
    <h2> @routeName's Observations </h2>

    @if (Model.Observations is not null && Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var ob in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/obs/@ob.Author.Username">@ob.Author.Name</a>
                        </strong>
                        @ob.Description
                        <small>&mdash; @ob.CreatedAt</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no Observations so far.</em>
    }
    <div style="display: flex; min-width: 100%;">
        @if (Model.BackwardUrl is not null) {
            <a href="@Model.BackwardUrl" style="justify-self: flex-start; width: 100%;">Previous Page</a>
        }
        @if (Model.ForwardUrl is not null) {
            <a href="@Model.ForwardUrl" style="justify-self: flex-end; width: 100%; text-align: right;">Next Page</a>
        }
    </div>
</div>
